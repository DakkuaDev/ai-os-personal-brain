# Agent-First Life OS — .env.example
# Copy to .env and fill. NEVER commit .env. These are the tokens the fleet shares.
# (Names are examples — match your agent runtime's conventions.)
# IMPORTANT: every block is an OPTIONAL MODULE — fill only what you enabled in
# scripts/setup.py (vault? composio? chat gateway?). Unused keys can stay empty.

# --- Chat platform module (only the CEO bot uses these; skip if platform = none) ---
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_HOME_CHANNEL=
# WhatsApp (when wired)
WHATSAPP_ALLOWED_USERS=

# Model provider
# e.g. OPENROUTER_API_KEY=, or a Nous/portal key, or local-only (Ollama) → leave blank

# Google Workspace (finance: Sheets/Gmail/Calendar)
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN=

# Notion (trip planner / agents matrix)
NOTION_API_KEY=

# --- Composio module (default tool bridge: GitHub, Gmail, Google Workspace, Notion, LinkedIn;
#    skip entirely if the person connects tools directly) ---
COMPOSIO_API_KEY=

# --- Vault module (Obsidian memory layer; skip if the person doesn't keep notes) ---
OBSIDIAN_VAULT_PATH=

# Peer bridge (local ↔ cloud)
API_SERVER_KEY=
HERMES_PEER_CLOUD_KEY=
